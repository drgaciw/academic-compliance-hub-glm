# =============================================================================
# STAGING ENVIRONMENT VARIABLES
# =============================================================================
# Environment: staging
# Purpose: Staging environment for testing
# Note: Update values with actual staging credentials

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://staging-user:staging-pass@staging-db.example.com:5432/aah_staging"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================
NEXTAUTH_SECRET=staging-secret-change-in-production
NEXTAUTH_URL=https://staging.aah.vercel.app
GOOGLE_CLIENT_ID=staging-google-client-id
GOOGLE_CLIENT_SECRET=staging-google-client-secret
MICROSOFT_CLIENT_ID=staging-microsoft-client-id
MICROSOFT_CLIENT_SECRET=staging-microsoft-client-secret
MICROSOFT_TENANT_ID=common
JWT_SECRET=staging-jwt-secret-change-in-production
JWT_EXPIRY=7d

# =============================================================================
# AI SERVICES
# =============================================================================
OPENAI_API_KEY=sk-staging-key
OPENAI_ORG_ID=org-staging
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=sk-ant-staging-key
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
LANGFUSE_PUBLIC_KEY=pk-lf-staging
LANGFUSE_SECRET_KEY=sk-lf-staging
LANGFUSE_HOST=https://cloud.langfuse.com
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_STREAMING_ENABLED=true

# =============================================================================
# VERCEL DEPLOYMENT
# =============================================================================
VERCEL_URL=https://staging.aah.vercel.app
VERCEL_ENV=production
NEXT_PUBLIC_VERCEL_ENV=production
TURBO_TOKEN=
TURBO_TEAM=

# =============================================================================
# MICROSERVICES URLS
# =============================================================================
USER_SERVICE_URL=https://staging.aah.vercel.app/api/user
ADVISING_SERVICE_URL=https://staging.aah.vercel.app/api/advising
COMPLIANCE_SERVICE_URL=https://staging.aah.vercel.app/api/compliance
REPORT_SERVICE_URL=https://staging.aah.vercel.app/api/report
MONITORING_SERVICE_URL=https://staging.aah.vercel.app/api/monitoring
SUPPORT_SERVICE_URL=https://staging.aah.vercel.app/api/support
INTEGRATION_SERVICE_URL=https://staging.aah.vercel.app/api/integration
AI_SERVICE_URL=https://staging.aah.vercel.app/api/ai
COURSE_MAPPING_SERVICE_URL=https://staging.aah.vercel.app/api/course-mapping
DOCUMENT_INGESTION_SERVICE_URL=https://staging.aah.vercel.app/api/document-ingestion
ELIGIBILITY_ENGINE_SERVICE_URL=https://staging.aah.vercel.app/api/eligibility

# =============================================================================
# REPORT SERVICE CONFIGURATION
# =============================================================================
REPORTS_DIR=/tmp/reports
REPORT_EXPIRY_DAYS=30
REPORT_MAX_RETRIES=3
START_WORKER=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=https://staging.aah.vercel.app
NODE_ENV=production
PORT=3000
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
RESEND_API_KEY=re_staging-key
EMAIL_FROM=noreply@staging.athleticacademicshub.com
EMAIL_FROM_NAME=Athletic Academics Hub (Staging)
PUSHER_APP_ID=staging-app-id
PUSHER_KEY=staging-key
PUSHER_SECRET=staging-secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=staging-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2
BLOB_READ_WRITE_TOKEN=vercel_blob_staging_token
GOOGLE_CALENDAR_CLIENT_ID=staging-gcal-id
GOOGLE_CALENDAR_CLIENT_SECRET=staging-gcal-secret
OUTLOOK_CLIENT_ID=staging-outlook-id
OUTLOOK_CLIENT_SECRET=staging-outlook-secret
CANVAS_API_URL=https://staging.instructure.com/api/v1
CANVAS_API_TOKEN=staging-canvas-token
BLACKBOARD_API_URL=https://staging.blackboard.com/api/v1
BLACKBOARD_API_KEY=staging-bb-key
SIS_API_URL=https://staging.edu/sis/api
SIS_API_KEY=staging-sis-key
PARCHMENT_API_KEY=staging-parchment-key
NSC_API_KEY=staging-nsc-key

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
SENTRY_DSN=https://staging@staging.ingest.sentry.io/staging
SENTRY_ORG=staging-org
SENTRY_PROJECT=aah-staging
SENTRY_AUTH_TOKEN=staging-auth-token
NEXT_PUBLIC_SENTRY_DSN=https://staging@staging.ingest.sentry.io/staging
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=staging-analytics-id

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================
KV_URL=redis://default:staging@staging.kv.vercel-storage.com:6379
KV_REST_API_URL=https://staging.kv.vercel-storage.com
KV_REST_API_TOKEN=staging-token
KV_REST_API_READ_ONLY_TOKEN=staging-read-only-token
EDGE_CONFIG=https://edge-config.vercel.com/staging?token=staging-token
CACHE_TTL=3600
CACHE_ENABLED=true

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================
ALLOWED_ORIGINS=https://staging.aah.vercel.app,https://staging-student.aah.vercel.app,https://staging-admin.aah.vercel.app
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ADMIN_MAX_REQUESTS=1000
CRON_SECRET=staging-cron-secret-change-in-production
ENCRYPTION_KEY=staging-32-char-encryption-key
ENCRYPTION_ALGORITHM=aes-256-gcm
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=3650
NEXT_PUBLIC_CSP_REPORT_URI=/api/csp-report
INTERNAL_SERVICE_TOKEN=staging-internal-token-change-in-production

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_ENABLED=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_REAL_TIME_NOTIFICATIONS=true
FEATURE_VOICE_INTERFACE=false
FEATURE_MULTI_LANGUAGE=false

# =============================================================================
# NCAA COMPLIANCE
# =============================================================================
NCAA_RULE_VERSION=2024-2025
NCAA_API_ENABLED=false
NCAA_VENDOR_API_URL=
NCAA_VENDOR_API_KEY=

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
DEBUG=false
TEST_DATABASE_URL="postgresql://staging-user:staging-pass@staging-db.example.com:5432/aah_test"
SKIP_ENV_VALIDATION=false

# =============================================================================
# MCP INTEGRATIONS
# =============================================================================
TESTSPRITE_API_KEY=sk-staging-testsprite-key

# =============================================================================
# VISUAL REGRESSION TESTING
# =============================================================================
CHROMATIC_PROJECT_TOKEN=chromatic_staging_token
