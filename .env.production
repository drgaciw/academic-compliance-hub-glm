# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Environment: production
# Purpose: Production environment
# WARNING: Keep these values secure! Never commit actual secrets to git.
# Get these values from secure vault or Vercel dashboard

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://prod-user:prod-pass@prod-db.example.com:5432/aah_prod"
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================
NEXTAUTH_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR
NEXTAUTH_URL=https://aah.vercel.app
GOOGLE_CLIENT_ID=CHANGE-ME
GOOGLE_CLIENT_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR
MICROSOFT_CLIENT_ID=CHANGE-ME
MICROSOFT_CLIENT_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR
MICROSOFT_TENANT_ID=common
JWT_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR-32-CHARS-MIN
JWT_EXPIRY=7d

# =============================================================================
# AI SERVICES
# =============================================================================
OPENAI_API_KEY=sk-CHANGE-ME
OPENAI_ORG_ID=org-CHANGE-ME
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE-ME
LANGFUSE_HOST=https://cloud.langfuse.com
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_STREAMING_ENABLED=true

# =============================================================================
# VERCEL DEPLOYMENT
# =============================================================================
VERCEL_URL=https://aah.vercel.app
VERCEL_ENV=production
NEXT_PUBLIC_VERCEL_ENV=production
TURBO_TOKEN=CHANGE-ME-GET-FROM-VERCEL
TURBO_TEAM=CHANGE-ME-GET-FROM-VERCEL

# =============================================================================
# MICROSERVICES URLS
# =============================================================================
USER_SERVICE_URL=https://aah.vercel.app/api/user
ADVISING_SERVICE_URL=https://aah.vercel.app/api/advising
COMPLIANCE_SERVICE_URL=https://aah.vercel.app/api/compliance
