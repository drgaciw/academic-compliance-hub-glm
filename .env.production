CACHE_TTL=3600
CACHE_ENABLED=true

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================
ALLOWED_ORIGINS=https://aah.vercel.app,https://student.aah.vercel.app,https://admin.aah.vercel.app
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ADMIN_MAX_REQUESTS=1000
CRON_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR-RANDOM-STRING
ENCRYPTION_KEY=CHANGE-ME-USE-VERCEL-ENV-VAR-32-CHARS-MIN
ENCRYPTION_ALGORITHM=aes-256-gcm
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=3650
NEXT_PUBLIC_CSP_REPORT_URI=/api/csp-report
INTERNAL_SERVICE_TOKEN=CHANGE-ME-USE-VERCEL-ENV-VAR-RANDOM-SECRET

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_ENABLED=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_REAL_TIME_NOTIFICATIONS=true
FEATURE_VOICE_INTERFACE=false
FEATURE_MULTI_LANGUAGE=false

# =============================================================================
