GOOGLE_CALENDAR_CLIENT_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR
OUTLOOK_CLIENT_ID=CHANGE-ME
OUTLOOK_CLIENT_SECRET=CHANGE-ME-USE-VERCEL-ENV-VAR
