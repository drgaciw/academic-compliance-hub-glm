# =============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# Environment: development
# Purpose: Local development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aah_dev"

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
MICROSOFT_CLIENT_ID=dev-microsoft-client-id
MICROSOFT_CLIENT_SECRET=dev-microsoft-client-secret
MICROSOFT_TENANT_ID=common
JWT_SECRET=dev-jwt-secret
JWT_EXPIRY=7d

# =============================================================================
# AI SERVICES
# =============================================================================
OPENAI_API_KEY=sk-dev-key
OPENAI_ORG_ID=org-dev
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=sk-ant-dev-key
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
LANGFUSE_HOST=https://cloud.langfuse.com
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_STREAMING_ENABLED=true

# =============================================================================
# VERCEL DEPLOYMENT
# =============================================================================
VERCEL_URL=localhost:3000
VERCEL_ENV=development
NEXT_PUBLIC_VERCEL_ENV=development
TURBO_TOKEN=
TURBO_TEAM=

# =============================================================================
# MICROSERVICES URLS
# =============================================================================
USER_SERVICE_URL=http://localhost:3001
ADVISING_SERVICE_URL=http://localhost:3002
COMPLIANCE_SERVICE_URL=http://localhost:3003
REPORT_SERVICE_URL=http://localhost:3004
MONITORING_SERVICE_URL=http://localhost:3005
SUPPORT_SERVICE_URL=http://localhost:3006
INTEGRATION_SERVICE_URL=http://localhost:3007
AI_SERVICE_URL=http://localhost:3008
COURSE_MAPPING_SERVICE_URL=http://localhost:3009
DOCUMENT_INGESTION_SERVICE_URL=http://localhost:3010
ELIGIBILITY_ENGINE_SERVICE_URL=http://localhost:3011

# =============================================================================
# REPORT SERVICE CONFIGURATION
# =============================================================================
REPORTS_DIR=./reports
REPORT_EXPIRY_DAYS=30
REPORT_MAX_RETRIES=3
START_WORKER=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
RESEND_API_KEY=re_dev-key
EMAIL_FROM=noreply@dev.athleticacademicshub.com
EMAIL_FROM_NAME=Athletic Academics Hub (Dev)
PUSHER_APP_ID=dev-app-id
PUSHER_KEY=dev-key
PUSHER_SECRET=dev-secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=dev-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2
BLOB_READ_WRITE_TOKEN=dev-blob-token
GOOGLE_CALENDAR_CLIENT_ID=dev-gcal-id
GOOGLE_CALENDAR_CLIENT_SECRET=dev-gcal-secret
OUTLOOK_CLIENT_ID=dev-outlook-id
OUTLOOK_CLIENT_SECRET=dev-outlook-secret
CANVAS_API_URL=https://dev.instructure.com/api/v1
CANVAS_API_TOKEN=dev-canvas-token
BLACKBOARD_API_URL=https://dev.blackboard.com/api/v1
BLACKBOARD_API_KEY=dev-bb-key
SIS_API_URL=https://dev.edu/sis/api
SIS_API_KEY=dev-sis-key
PARCHMENT_API_KEY=dev-parchment-key
NSC_API_KEY=dev-nsc-key

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
SENTRY_DSN=https://dev@dev.ingest.sentry.io/dev
SENTRY_ORG=dev-org
SENTRY_PROJECT=aah-dev
SENTRY_AUTH_TOKEN=dev-auth-token
NEXT_PUBLIC_SENTRY_DSN=https://dev@dev.ingest.sentry.io/dev
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=dev-analytics-id

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================
KV_URL=redis://localhost:6379
KV_REST_API_URL=http://localhost:6379
KV_REST_API_TOKEN=dev-token
KV_REST_API_READ_ONLY_TOKEN=dev-read-only-token
EDGE_CONFIG=https://edge-config.vercel.com/dev?token=dev-token
CACHE_TTL=3600
CACHE_ENABLED=true

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ADMIN_MAX_REQUESTS=1000
CRON_SECRET=dev-cron-secret
ENCRYPTION_KEY=dev-32-char-encryption-key
ENCRYPTION_ALGORITHM=aes-256-gcm
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=3650
NEXT_PUBLIC_CSP_REPORT_URI=/api/csp-report
INTERNAL_SERVICE_TOKEN=dev-internal-token

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_ENABLED=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_REAL_TIME_NOTIFICATIONS=true
FEATURE_VOICE_INTERFACE=false
FEATURE_MULTI_LANGUAGE=false

# =============================================================================
# NCAA COMPLIANCE
# =============================================================================
NCAA_RULE_VERSION=2024-2025
NCAA_API_ENABLED=false
NCAA_VENDOR_API_URL=
NCAA_VENDOR_API_KEY=

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
DEBUG=true
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aah_test"
SKIP_ENV_VALIDATION=false

# =============================================================================
# MCP INTEGRATIONS
# =============================================================================
TESTSPRITE_API_KEY=sk-dev-testsprite-key

# =============================================================================
# VISUAL REGRESSION TESTING
# =============================================================================
CHROMATIC_PROJECT_TOKEN=chromatic_dev_token
