    {
      "id": "document-ingestion-001",
      "name": "Document Ingestion - POST /upload",
      "description": "Test document upload endpoint",
      "service": "document-ingestion",
      "endpoint": "/upload",
      "method": "POST",
      "testCases": [
        {
          "id": "TC-015",
          "name": "Upload valid PDF document",
          "description": "Test successful document upload with valid PDF",
          "request": {
            "body": {
              "file": {
                "name": "transcript.pdf",
                "type": "application/pdf",
                "size": 102400
              }
            }
          },
          "expectedResponse": {
            "status": 201,
            "body": {
              "success": true,
              "documentId": "doc_1234567890_abc123",
              "metadata": {
                "fileName": "transcript.pdf",
                "fileType": "application/pdf",
                "fileSize": 102400,
                "category": "TRANSCRIPT",
                "pageCount": 5,
                "isTranscript": true
              },
              "storageUrl": "https://blob.example.com/transcript.pdf"
            }
          }
        },
        {
          "id": "TC-016",
          "name": "Upload without file",
          "description": "Test error handling when no file is provided",
          "request": {
            "body": {}
          },
          "expectedResponse": {
            "status": 400,
            "body": {
              "success": false,
              "error": "No file provided"
            }
          }
        },
        {
          "id": "TC-017",
          "name": "Upload invalid file type",
          "description": "Test validation error for unsupported file type",
          "request": {
            "body": {
              "file": {
                "name": "malicious.exe",
                "type": "application/x-msdownload",
                "size": 1024
              }
            }
          },
          "expectedResponse": {
            "status": 400,
            "body": {
              "success": false,
              "error": "Invalid file type"
            }
          }
        },
        {
          "id": "TC-018",
          "name": "Upload file exceeding size limit",
          "description": "Test validation error for file size exceeding limit",
          "request": {
            "body": {
              "file": {
                "name": "large.pdf",
                "type": "application/pdf",
                "size": 104857600
              }
            }
          },
          "expectedResponse": {
            "status": 400,
            "body": {
              "success": false,
              "error": "File size exceeds maximum limit"
            }
          }
        },
        {
          "id": "TC-019",
          "name": "Upload file with virus detected",
          "description": "Test error handling when virus is detected",
          "request": {
            "body": {
              "file": {
                "name": "infected.pdf",
                "type": "application/pdf",
                "size": 1024
              }
            }
          },
          "expectedResponse": {
            "status": 403,
            "body": {
              "success": false,
              "error": "File contains threats and cannot be uploaded",
              "threats": ["EICAR-Test-File"]
            }
          }
        }
      ]
    },
