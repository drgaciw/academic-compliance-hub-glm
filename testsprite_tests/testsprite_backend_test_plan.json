    {
      "id": "eligibility-engine-003",
      "name": "Eligibility Engine - POST /api/eligibility/gpa",
      "description": "Test GPA calculation endpoint",
      "service": "eligibility-engine",
      "endpoint": "/api/eligibility/gpa",
      "method": "POST",
      "testCases": [
        {
          "id": "TC-006",
          "name": "Calculate GPA with valid courses",
          "description": "Test successful GPA calculation",
          "request": {
            "body": {
              "studentId": "STU001",
              "courses": [
                {
                  "courseId": "MATH101",
                  "credits": 3,
                  "grade": "A"
                },
                {
                  "courseId": "ENG101",
                  "credits": 3,
                  "grade": "B"
                }
              ]
            }
          },
          "expectedResponse": {
            "status": 200,
            "body": {
              "success": true,
              "data": {
                "studentId": "STU001",
                "gpa": 3.5,
                "totalCredits": 6,
                "gradePoints": 21
              }
            }
          }
        },
        {
          "id": "TC-007",
          "name": "Calculate GPA with pass/fail courses",
          "description": "Test GPA calculation excluding pass/fail courses",
          "request": {
            "body": {
              "studentId": "STU001",
              "courses": [
                {
                  "courseId": "MATH101",
                  "credits": 3,
                  "grade": "A"
                },
                {
                  "courseId": "PE101",
                  "credits": 1,
                  "grade": "P",
                  "isPassFail": true
                }
              ],
              "includePassFail": false
            }
          },
          "expectedResponse": {
            "status": 200,
            "body": {
              "success": true,
              "data": {
                "studentId": "STU001",
                "gpa": 4.0,
                "totalCredits": 3,
                "gradePoints": 12
              }
            }
          }
        }
      ]
    },
