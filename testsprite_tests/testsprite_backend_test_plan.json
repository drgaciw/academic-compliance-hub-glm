{
  "projectName": "athletic-academics-hub",
  "testType": "backend",
  "testPlan": [
    {
      "id": "eligibility-engine-001",
      "name": "Eligibility Engine - POST /api/eligibility/evaluate",
      "description": "Test student eligibility evaluation endpoint",
      "service": "eligibility-engine",
      "endpoint": "/api/eligibility/evaluate",
      "method": "POST",
      "testCases": [
        {
          "id": "TC-001",
          "name": "Valid eligibility evaluation request",
          "description": "Test successful eligibility evaluation with valid student data",
          "request": {
            "body": {
              "studentId": "STU001",
              "season": "FALL",
              "sport": "Basketball",
              "term": "2024"
            }
          },
          "expectedResponse": {
            "status": 200,
            "body": {
              "success": true,
              "data": {
                "studentId": "STU001",
                "isEligible": true,
                "gpa": 3.5,
                "credits": 30,
                "violations": []
              }
            }
          }
        },
        {
          "id": "TC-002",
          "name": "Missing required studentId",
          "description": "Test validation error when studentId is missing",
          "request": {
            "body": {
              "season": "FALL",
              "sport": "Basketball"
            }
          },
          "expectedResponse": {
            "status": 400,
            "body": {
              "success": false,
              "error": "VALIDATION_ERROR"
            }
          }
        },
        {
          "id": "TC-003",
          "name": "Student not found",
          "description": "Test error handling when student does not exist",
          "request": {
            "body": {
              "studentId": "NONEXISTENT"
            }
          },
          "expectedResponse": {
            "status": 404,
            "body": {
              "success": false,
              "error": "STUDENT_NOT_FOUND"
            }
          }
        }
      ]
    },
    {
