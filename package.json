{
  "name": "athletic-academics-hub",
  "version": "2.0.0",
  "private": true,
  "description": "Athletic Academics Hub (AAH) - A SaaS platform for university athletic academic support with AI capabilities",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:affected": "turbo run build --filter=\"[HEAD^1]\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:keyboard": "playwright test e2e/keyboard-navigation.spec.ts",
    "test:focus": "playwright test e2e/focus-management.spec.ts",
    "test:transfer-request": "playwright test e2e/transfer-request.spec.ts",
    "test:admin-user": "playwright test e2e/admin-user-management.spec.ts",
    "test:cross-zone": "playwright test e2e/cross-zone-navigation.spec.ts",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "test:ui": "turbo run test:ui",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "type-check:staged": "turbo run type-check -- --pretty",
    "clean": "turbo run clean",
    "validate:env": "node scripts/validate-env.js development",
    "validate:env:staging": "node scripts/validate-env.js staging",
    "validate:env:production": "node scripts/validate-env.js production",
    "rollback": "bash scripts/rollback.sh",
    "rollback:production": "bash scripts/rollback.sh production",
    "rollback:staging": "bash scripts/rollback.sh staging",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @aah/database db:generate",
    "db:push": "pnpm --filter @aah/database db:push",
    "db:migrate": "pnpm --filter @aah/database db:migrate",
    "db:studio": "pnpm --filter @aah/database db:studio",
    "dev:main": "turbo run dev --filter=main-app",
    "dev:student": "turbo run dev --filter=student-app",
    "dev:admin": "turbo run dev --filter=admin-app",
    "build:main": "turbo run build --filter=main-app",
    "build:student": "turbo run build --filter=student-app",
    "build:admin": "turbo run build --filter=admin-app",
    "docs:dev": "cd docs && pnpm dev",
    "docs:build": "cd docs && pnpm build",
    "docs:start": "cd docs && pnpm start",
    "chromatic": "cd packages/ui && pnpm chromatic",
    "chromatic:baselines": "cd packages/ui && pnpm chromatic:baselines",
    "storybook": "cd packages/ui && pnpm storybook",
    "size-limit": "size-limit",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.57.0",
    "@size-limit/preset-big-lib": "^11.2.0",
    "@types/next": "^9.0.0",
    "@types/node": "^20.10.0",
    "lint-staged": "^16.2.7",
    "next": "^14.0.0",
    "nextra": "^4.6.1",
    "playwright": "^1.57.0",
    "prettier": "^3.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^3.6.2",
    "size-limit": "^11.2.0",
    "turbo": "^2.7.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@sentry/browser": "^10.32.1",
    "@sentry/nextjs": "^10.32.1",
    "@sentry/node": "^10.32.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.0",
    "@vercel/speed-insights": "^1.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.0.4",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0-canary-7118f5dd7-20230705",
    "eslint-scope": "^7.2.2",
    "eslint-visitor-keys": "^3.4.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
