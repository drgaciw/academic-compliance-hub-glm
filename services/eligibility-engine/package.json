{
  "name": "@aah/service-eligibility-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Eligibility evaluation microservice for academic compliance",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "hono dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aah/api-utils": "workspace:*",
    "@aah/compliance-engine": "workspace:*",
    "@aah/database": "workspace:*",
    "@hono/zod-validator": "^0.2.0",
    "hono": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@aah/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.ts$": "$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
