// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocumentEmbedding {
  id                String    @id @default(cuid())
  transcriptDocumentId    String
  transcriptDocument      TranscriptDocument @relation(fields: [transcriptDocumentId], references: [id], onDelete: Cascade)
  embedding        Unsupported("vector(1536)")?
  content          String    @db.Text
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([transcriptDocumentId])
  @@map("document_embeddings")
}

// User model
model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
  advisorProfile AdvisorProfile?
  adminProfile   AdminProfile?
  notifications Notification[]

  @@map("users")
}

// Role enum
enum Role {
  STUDENT
  ADVISOR
  ADMIN
  COMPLIANCE_OFFICER
}

// Student profile
model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId       String   @unique
  sport           String
  year            Int
  gpa             Float?
  credits         Int      @default(0)
  eligibility     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courses         CourseEnrollment[]
  tutoringSessions TutoringSession[]
  complianceRecords ComplianceRecord[]
  transcriptDocuments TranscriptDocument[]
  transferEvaluations TransferEvaluation[]
  advisor         AdvisorProfile? @relation("AdvisorStudents", fields: [advisorId], references: [id], onDelete: SetNull)
  advisorId       String?
  waiverRequests  WaiverRequest[]
  reportMetadata   ReportMetadata[] @relation("ReportMetadataStudent")
  transferRequests TransferRequest[]

  @@index([studentId])
  @@index([advisorId])
  @@index([eligibility])
  @@map("student_profiles")
}

// Advisor profile
model AdvisorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      String
  students        StudentProfile[] @relation("AdvisorStudents")

  @@map("advisor_profiles")
}

// Admin profile
model AdminProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions     String[]

  @@map("admin_profiles")
}

// Course model
model Course {
  id              String   @id @default(cuid())
  code            String
  name            String
  credits         Int
  department      String
  semester        String
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments     CourseEnrollment[]

  @@unique([code, semester, year])
  @@map("courses")
}

// Course enrollment
model CourseEnrollment {
  id              String   @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade           String?
  status          EnrollmentStatus @default(IN_PROGRESS)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, courseId])
  @@map("course_enrollments")
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  DROPPED
  WITHDRAWN
}

// Tutoring session
model TutoringSession {
  id              String   @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         String
  date            DateTime
  duration        Int      // minutes
  notes           String?
  status          SessionStatus @default(SCHEDULED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tutoring_sessions")
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Compliance record
model ComplianceRecord {
  id              String   @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transferRequestId String?
  transferRequest TransferRequest? @relation(fields: [transferRequestId], references: [id], onDelete: SetNull)
  category        String
  requirement     String
  status          ComplianceStatus @default(PENDING)
  notes           String?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([transferRequestId])
  @@map("compliance_records")
}

enum ComplianceStatus {
  PENDING
  COMPLETED
  FAILED
  EXEMPTED
}

// A1-004: Institution and related enums
enum InstitutionType {
  UNIVERSITY
  COLLEGE
  COMMUNITY_COLLEGE
  JUNIOR_COLLEGE
  TECHNICAL_SCHOOL
}

enum NCAADivision {
  DIVISION_I
  DIVISION_II
  DIVISION_III
  NAIA
  NJCAA
}

enum SISType {
  FULL_SIS
  PARTIAL_SIS
  MANUAL_TRANSCRIPT
  PDF_TRANSCRIPT
}

enum SubjectArea {
  ENGLISH
  MATH
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
  HUMANITIES
  FINE_ARTS
  PHYSICAL_EDUCATION
  FOREIGN_LANGUAGE
  COMPOSITION
  SPEECH
  PHILOSOPHY
  PSYCHOLOGY
  SOCIOLOGY
  POLITICAL_SCIENCE
  ECONOMICS
  HISTORY
  GEOGRAPHY
  COMPUTER_SCIENCE
  INFORMATION_TECHNOLOGY
  BUSINESS
  ACCOUNTING
  MARKETING
  MANAGEMENT
  FINANCE
}

enum EligibilityStatus {
  PENDING_REVIEW
  ELIGIBLE
  INELIGIBLE
  CONDITIONAL
  NEEDS_DOCUMENTATION
  UNDER_EVALUATION
  APPEALED
}

enum ExtractionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
  REQUIRES_REVIEW
}

enum AgentType {
  EVALUATION_AGENT
  COMPLIANCE_AGENT
  DOCUMENT_AGENT
  RULE_ENGINE
  NOTIFICATION_AGENT
  ADVISOR_AGENT
}

// A1-004: Institution model
model Institution {
  id                String       @id @default(cuid())
  name              String
  code              String       @unique
  type              InstitutionType
  ncaaDivision      NCAADivision?
  ncaaCertified     Boolean      @default(false)
  sisType           SISType?
  region            String?
  country           String       @default("US")
  state             String?
  website           String?
  email             String?
  phone             String?
  address           String?
  isActive          Boolean      @default(true)
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  transferEvaluationsAsSource TransferEvaluation[] @relation("SourceInstitution")
  transferEvaluationsAsTarget TransferEvaluation[] @relation("TargetInstitution")
  transcriptDocuments         TranscriptDocument[]
  courseMappingsAsSource     CourseMapping[] @relation("SourceInstitution")
  courseMappingsAsTarget     CourseMapping[] @relation("TargetInstitution")

  @@index([code])
  @@index([type])
  @@index([ncaaDivision])
  @@index([isActive])
  @@map("institutions")
}

// A1-002: TranscriptDocument model
model TranscriptDocument {
  id                    String           @id @default(cuid())
  studentProfileId      String
  studentProfile        StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  institutionId         String?
  institution           Institution?     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  transferEvaluation    TransferEvaluation? @relation("TransferEvaluationDocument")
  fileName              String
  fileType              String
  fileSize              Int
  fileUrl               String
  extractionStatus      ExtractionStatus @default(NOT_STARTED)
  extractionStartedAt   DateTime?
  extractionCompletedAt  DateTime?
  extractionMetadata    Json?
  uploadedAt            DateTime         @default(now())
  processedAt           DateTime?
  embeddings           DocumentEmbedding[]

  @@index([studentProfileId])
  @@index([institutionId])
  @@index([extractionStatus])
  @@index([uploadedAt])
  @@map("transcript_documents")
}

// A1-001: TransferEvaluation model
model TransferEvaluation {
  id                    String           @id @default(cuid())
  studentProfileId      String
  studentProfile        StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  sourceInstitutionId   String
  sourceInstitution     Institution      @relation("SourceInstitution", fields: [sourceInstitutionId], references: [id])
  targetInstitutionId   String?
  targetInstitution     Institution?     @relation("TargetInstitution", fields: [targetInstitutionId], references: [id])
  transcriptDocumentId  String?           @unique
  transcriptDocument    TranscriptDocument? @relation("TransferEvaluationDocument", fields: [transcriptDocumentId], references: [id], onDelete: SetNull)
  eligibilityStatus     EligibilityStatus @default(PENDING_REVIEW)
  totalCredits          Int              @default(0)
  transferableCredits   Int              @default(0)
  gpa                   Float?
  confidenceScore       Float            @default(0.0)
  evaluationNotes       String?
  evaluationMetadata    Json?
  evaluatedAt           DateTime?
  evaluatedBy           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  courseMappings        CourseMapping[]
  auditLogs             AuditLog[]
  transferRequests      TransferRequest[]

  @@index([studentProfileId])
  @@index([sourceInstitutionId])
  @@index([targetInstitutionId])
  @@index([eligibilityStatus])
  @@index([createdAt])
  @@index([studentProfileId, eligibilityStatus])
  @@map("transfer_evaluations")
}

// A1-003: CourseMapping model
model CourseMapping {
  id                    String            @id @default(cuid())
  transferEvaluationId  String
  transferEvaluation    TransferEvaluation @relation(fields: [transferEvaluationId], references: [id], onDelete: Cascade)
  sourceInstitutionId   String
  sourceInstitution     Institution       @relation("SourceInstitution", fields: [sourceInstitutionId], references: [id])
  targetInstitutionId   String?
  targetInstitution     Institution?      @relation("TargetInstitution", fields: [targetInstitutionId], references: [id])
  sourceCourseCode      String
  sourceCourseTitle     String
  sourceCredits         Int
  sourceSubjectArea     SubjectArea
  targetCourseCode      String?
  targetCourseTitle     String?
  targetCredits         Int?
  targetSubjectArea     SubjectArea?
  isEquivalent          Boolean           @default(false)
  confidenceScore       Float             @default(0.0)
  verificationStatus    VerificationStatus @default(PENDING)
  verificationNotes     String?
  ruleApplied           String?
  exceptionReason       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([transferEvaluationId])
  @@index([sourceInstitutionId])
  @@index([targetInstitutionId])
  @@index([sourceCourseCode])
  @@index([sourceSubjectArea])
  @@index([targetSubjectArea])
  @@index([isEquivalent])
  @@index([verificationStatus])
  @@map("course_mappings")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  MANUAL_REVIEW
  AUTO_APPROVED
  EXEMPTION_GRANTED
}

// A1-005: NCAARule model
model NCAARule {
  id              String      @id @default(cuid())
  bylawNumber     String      @unique
  title           String
  description     String      @db.Text
  division        NCAADivision?
  category        String
  subCategory     String?
  agentType       AgentType?
  isActive        Boolean     @default(true)
  version         Int         @default(1)
  effectiveDate   DateTime?
  expirationDate  DateTime?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("ncaa_rules")
}

// A1-006: AuditLog model
model AuditLog {
  id                    String      @id @default(cuid())
  transferEvaluationId  String
  transferEvaluation    TransferEvaluation @relation(fields: [transferEvaluationId], references: [id], onDelete: Cascade)
  agentType             AgentType
  action                String
  inputData             Json?
  outputData            Json?
  errorMessage          String?
  duration              Int?
  timestamp             DateTime    @default(now())

  @@index([transferEvaluationId])
  @@index([agentType])
  @@index([timestamp])
  @@index([transferEvaluationId, timestamp])
  @@map("audit_logs")
}

// F2-003: AuditLogArchive model for 7-year retention
model AuditLogArchive {
  id                    String      @id @default(cuid())
  originalLogId         String      @unique
  transferEvaluationId  String
  agentType             AgentType
  action                String
  inputData             Json?
  outputData            Json?
  errorMessage          String?
  duration              Int?
  originalTimestamp     DateTime
  archivedAt            DateTime    @default(now())
  archivedBy            String      @default("SYSTEM")
  compressionType       String      @default("NONE")
  archiveMetadata       Json?

  @@index([originalTimestamp])
  @@index([archivedAt])
  @@index([transferEvaluationId])
  @@index([agentType])
  @@index([originalTimestamp, archivedAt])
  @@map("audit_log_archives")
}

// Report Service Models

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportType {
  ELIGIBILITY
  TRANSFER_CREDIT
  COMPLIANCE
  PROGRESS
  CUSTOM
}

enum ReportFormat {
  PDF
  CSV
  JSON
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(INFO)
  title       String   @db.Text
  message     String   @db.Text
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model ReportMetadata {
  id                String        @id @default(cuid())
  type              ReportType
  format            ReportFormat  @default(PDF)
  status            ReportStatus  @default(PENDING)
  userId            String?
  studentProfileId   String?
  studentProfile     StudentProfile? @relation("ReportMetadataStudent", fields: [studentProfileId], references: [id], onDelete: SetNull)
  templateId        String?
  template          ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  filePath          String?
  fileName          String?
  fileSize          Int?
  progress          Int           @default(0)
  signatureFields   Json?
  signatureData     String?
  signedAt          DateTime?
  error             String?
  expiresAt         DateTime?
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([studentProfileId])
  @@index([templateId])
  @@index([expiresAt])
  @@index([type, status])
  @@map("report_metadata")
}

model ReportTemplate {
  id                String          @id @default(cuid())
  name              String
  description       String?
  type              ReportType
  customTemplate    String?
  signatureFields   Json?
  createdBy         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  reports           ReportMetadata[]

  @@index([type])
  @@map("report_templates")
}

// Eligibility Engine - Waiver Models

enum WaiverType {
  INITIAL_ELIGIBILITY
  PROGRESS_TOWARD_DEGREE
  CREDIT_HOUR_REQUIREMENTS
  GPA_REQUIREMENTS
}

enum WaiverStatus {
  DRAFT
  PENDING_DOCUMENTATION
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  NCAA_REVIEW
  APPROVED
  DENIED
  EXPIRED
  WITHDRAWN
}

enum WaiverScenario {
  MEDICAL_HARDSHIP
  MILITARY_SERVICE
  RELIGIOUS_ACCOMMODATION
  LEARNING_DISABILITY
  NATURAL_DISASTER
  NCAA_EXTENUATING_CIRCUMSTANCES
  FAMILY_EMERGENCY
  FINANCIAL_HARDSHIP
}

enum DocumentStatus {
  REQUIRED
  PENDING_UPLOAD
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model WaiverRequest {
  id                    String         @id @default(cuid())
  studentProfileId      String
  studentProfile        StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  waiverType            WaiverType
  scenario              WaiverScenario
  status                WaiverStatus    @default(DRAFT)
  ruleId                String?
  ruleName              String?
  bylawReference        String?
  violationId           String?
  justification         String         @db.Text
  expirationDate        DateTime?
  submittedAt           DateTime?
  submittedBy           String?
  ncaaSubmittedAt       DateTime?
  ncaaReferenceNumber   String?        @unique
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewDecision        String?
  reviewJustification   String?        @db.Text
  ncaaResponseDate      DateTime?
  ncaaResponse          String?
  ncaaResponseNotes     String?        @db.Text
  effectiveDate         DateTime?
  createdDate           DateTime       @default(now())
  updatedDate           DateTime       @updatedAt
  createdBy             String
  metadata              Json?

  waiverDocuments       WaiverDocument[]
  auditLogs             WaiverAuditLog[]

  @@index([studentProfileId])
  @@index([waiverType])
  @@index([status])
  @@index([ruleId])
  @@index([submittedAt])
  @@index([ncaaReferenceNumber])
  @@index([createdDate])
  @@map("waiver_requests")
}

model WaiverDocument {
  id                    String         @id @default(cuid())
  waiverRequestId       String
  waiverRequest         WaiverRequest  @relation(fields: [waiverRequestId], references: [id], onDelete: Cascade)
  documentType          String
  description           String?
  fileName              String
  fileUrl               String
  fileSize              Int
  status                DocumentStatus @default(PENDING_UPLOAD)
  uploadedAt            DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNotes           String?
  expirationDate        DateTime?
  uploadedBy            String?
  metadata              Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([waiverRequestId])
  @@index([documentType])
  @@index([status])
  @@index([expirationDate])
  @@map("waiver_documents")
}

model WaiverAuditLog {
  id                    String         @id @default(cuid())
  waiverRequestId      String
  waiverRequest         WaiverRequest  @relation(fields: [waiverRequestId], references: [id], onDelete: Cascade)
  action                String
  actorId               String
  actorName             String
  previousStatus        WaiverStatus?
  newStatus             WaiverStatus?
  inputData             Json?
  outputData            Json?
  notes                 String?        @db.Text
  timestamp             DateTime       @default(now())
  ipAddress             String?
  userAgent             String?

  @@index([waiverRequestId])
  @@index([action])
  @@index([actorId])
  @@index([timestamp])
  @@map("waiver_audit_logs")
}

// T1.4.3: Transfer Request Model
enum TransferRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_DOCUMENTATION
  IN_EVALUATION
  AWAITING_DECISION
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  CANCELLED
  ON_HOLD
  COMPLETED
}

enum TransferRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TransferRequestType {
  INITIAL_TRANSFER
  PROGRESS_TOWARD_DEGREE
  ELIGIBILITY_CERTIFICATION
  WAIVER_REQUEST
  APPEAL
  AMENDMENT
}

model TransferRequest {
  id                    String                @id @default(cuid())
  studentProfileId      String
  studentProfile        StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  type                  TransferRequestType   @default(INITIAL_TRANSFER)
  status                TransferRequestStatus @default(DRAFT)
  priority              TransferRequestPriority @default(NORMAL)
  transferEvaluationId  String?
  transferEvaluation    TransferEvaluation?   @relation(fields: [transferEvaluationId], references: [id], onDelete: SetNull)
  requestedCredits      Int?
  approvedCredits       Int?
  denialReason          String?
  submissionDate        DateTime?
  reviewStartDate       DateTime?
  decisionDate          DateTime?
  effectiveDate         DateTime?
  expirationDate        DateTime?
  requestingInstitution String?
  receivingInstitution  String?
  academicYear          String?
  term                  String?
  sport                 String?
  notes                 String?               @db.Text
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  complianceRecords      ComplianceRecord[]
  attachments           TransferRequestAttachment[]
  approvalChain         TransferApproval[]

  @@index([studentProfileId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([submissionDate])
  @@index([decisionDate])
  @@index([academicYear, term])
  @@index([sport])
  @@map("transfer_requests")
}

model TransferRequestAttachment {
  id                    String         @id @default(cuid())
  transferRequestId     String
  transferRequest       TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)
  documentType          String
  fileName              String
  fileUrl               String
  fileSize              Int
  uploadedAt            DateTime       @default(now())
  uploadedBy            String?
  description           String?
  metadata              Json?

  @@index([transferRequestId])
  @@index([documentType])
  @@map("transfer_request_attachments")
}

model TransferApproval {
  id                    String         @id @default(cuid())
  transferRequestId     String
  transferRequest       TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)
  approverId            String
  approverName          String
  approverRole          String
  action                String
  decision              String
  comments              String?
  approvedAt            DateTime       @default(now())

  @@index([transferRequestId])
  @@index([approverId])
  @@index([approvedAt])
  @@map("transfer_approvals")
}
