{
  "name": "@aah/ui",
  "version": "2.1.0",
  "private": true,
  "description": "Shared UI components using Shadcn/UI",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
